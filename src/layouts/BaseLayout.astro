---
import "../styles/global.css";
import type { SiteLocale } from "../types/site";
import type { SiteUiCopy } from "../data/ui";

type Props = {
  locale: SiteLocale;
  ui: SiteUiCopy;
};

const { locale, ui } = Astro.props;
const { title, description, jobTitle, ogLocale } = ui.seo;
const siteUrl = Astro.site!;
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL("/images/leonardo-portrait-wide.webp", siteUrl);
const portugueseUrl = new URL("/", siteUrl);
const englishUrl = new URL("/en/", siteUrl);
const alternateLocale = locale === "pt-BR" ? "en_US" : "pt_BR";
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Leonardo Candiani",
  url: siteUrl.toString(),
  jobTitle,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Maringá",
    addressRegion: "PR",
    addressCountry: "BR"
  },
  sameAs: [
    "https://github.com/leonardocandiani",
    "https://instagram.com/leonardocandiani",
    "https://youtube.com/@oleonardocandiani"
  ]
};
---

<!doctype html>
<html lang={locale} data-tone="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/InterDisplay-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="image" href="/images/leonardo-mini.webp" type="image/webp" fetchpriority="high" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang="pt-BR" href={portugueseUrl.toString()} />
    <link rel="alternate" hreflang="en" href={englishUrl.toString()} />
    <link rel="alternate" hreflang="x-default" href={portugueseUrl.toString()} />
    <link rel="icon" href="/favicon.png?v=4" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.toString()} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{ui.layout.skipLink}</a>
    <slot />
    <div class="k-fade-top" aria-hidden="true"></div>
    <div class="k-fade" aria-hidden="true"></div>
    <script>
      import { startKit } from "../scripts/kit-olek.js";
      startKit();
    </script>
    <script is:inline>
      const revealItems = Array.from(document.querySelectorAll("[data-reveal], [data-media-reveal]"));
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const navigationLinks = Array.from(document.querySelectorAll('.desktop-nav a[href^="#"]'));
      const navigationSections = navigationLinks.map((link) => document.querySelector(link.getAttribute("href"))).filter(Boolean);
      if ("IntersectionObserver" in window) {
        const activeSections = new Set();
        const navigationObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) activeSections.add(entry.target.id);
            else activeSections.delete(entry.target.id);
          });
          const currentSection = navigationSections.find((section) => activeSections.has(section.id));
          navigationLinks.forEach((link) => {
            if (currentSection && link.hash === `#${currentSection.id}`) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          });
        }, { rootMargin: "-12% 0px -55% 0px" });
        navigationSections.forEach((section) => navigationObserver.observe(section));
      }

      if (revealItems.length > 0) {
        if (prefersReducedMotion) {
          requestAnimationFrame(() => {
            revealItems.forEach((item) => {
              item.setAttribute("data-reveal-ready", "true");
            });

            requestAnimationFrame(() => {
              revealItems.forEach((item) => {
                item.setAttribute("data-visible", "true");
              });
            });
          });
        } else if (!("IntersectionObserver" in window)) {
          revealItems.forEach((item) => {
            item.setAttribute("data-visible", "true");
          });
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) {
                  return;
                }

                entry.target.setAttribute("data-visible", "true");
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: "0px 0px -40px 0px" }
          );

          requestAnimationFrame(() => {
            revealItems.forEach((item) => {
              item.setAttribute("data-reveal-ready", "true");
              observer.observe(item);
            });
          });
        }
      }
    </script>
  </body>
</html>
