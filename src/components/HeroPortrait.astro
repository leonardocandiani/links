---
import type { SiteContent } from "../types/site";
import type { SiteUiCopy } from "../data/ui";

type Props = {
  hero: SiteContent["hero"];
  ui: SiteUiCopy["hero"];
};

const { hero, ui } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-media">
    <source media="(min-width: 64rem)" srcset="/images/hero-horizon-wide.webp" type="image/webp" />
    <img
      src="/images/hero-horizon-mobile.webp"
      alt={ui.imageAlt}
      width="941"
      height="1672"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </picture>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content page-width">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title" class="display">{hero.title}</h1>
    <p class="body-large">{hero.description}</p>
    <div class="hero-actions" aria-label={ui.actionsLabel}>
      <a class="hero-button hero-button-primary pressable" href="#sobre">{ui.primaryCta}</a>
      <a class="hero-button hero-button-secondary pressable" href="#repertorio">{ui.secondaryCta}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    background: var(--color-ink);
    color: white;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-media,
  .hero-media img,
  .hero-shade {
    position: absolute;
    inset: 0;
  }

  .hero-media {
    z-index: -2;
    display: block;
    height: auto;
    overflow: hidden;
    background: var(--color-sky-light);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .hero-shade {
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(8 12 16 / 4%) 20%, rgb(8 12 16 / 22%) 50%, rgb(8 12 16 / 92%) 100%),
      linear-gradient(90deg, rgb(8 12 16 / 56%), rgb(8 12 16 / 5%) 76%);
  }

  .hero-content {
    display: grid;
    align-content: end;
    min-height: 100svh;
    gap: clamp(.9rem, 2vw, 1.3rem);
    padding-top: 7rem;
    padding-bottom: clamp(1.5rem, 5vh, 3rem);
  }

  .hero .eyebrow {
    margin: 0;
    color: white;
  }

  .hero .display {
    max-width: 10ch;
    color: white;
    font-size: clamp(2.45rem, 2.1rem + 1.8vw, 3.75rem);
    font-weight: 590;
    line-height: .94;
    text-wrap: balance;
  }

  .hero .body-large {
    max-width: 31rem;
    color: rgb(255 255 255 / 88%);
    font-size: clamp(1rem, .94rem + .25vw, 1.125rem);
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    padding-top: .35rem;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-control);
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: 0;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .hero-button-primary {
    border: 1px solid white;
    background: white;
    color: var(--color-ink);
  }

  .hero-button-secondary {
    border: 1px solid rgb(255 255 255 / 54%);
    background-color: #45332a;
    background-color: rgb(23 21 19 / 58%);
    color: white;
  }

  .hero-button-primary:hover {
    background: rgb(242 238 231 / 94%);
    border-color: rgb(242 238 231 / 94%);
  }

  .hero-button-secondary:hover {
    border-color: rgb(255 255 255 / 76%);
    background-color: #171513;
    background-color: rgb(23 21 19 / 68%);
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .hero .display {
      font-size: clamp(2.75rem, 5.6vw, 3.6rem);
      line-height: .96;
    }

    .hero .body-large {
      font-size: 1.125rem;
      line-height: 1.5;
    }
  }

  @media (min-width: 64rem) {
    .hero-media img {
      object-position: center;
    }

    .hero-shade {
      z-index: -1;
      background:
        linear-gradient(
          90deg,
          rgb(8 12 16 / 72%) 0%,
          rgb(8 12 16 / 58%) 24%,
          rgb(8 12 16 / 24%) 47%,
          rgb(8 12 16 / 0%) 72%
        );
    }

    .hero .display {
      max-width: 9.5ch;
      font-size: clamp(4.25rem, 5.4vw, 5.8rem);
      line-height: .92;
    }

    .hero-content {
      align-content: end;
      min-height: 100svh;
      padding-top: clamp(7rem, 14vh, 9rem);
      padding-bottom: clamp(2rem, 8vh, 5.5rem);
    }

    .hero .body-large {
      font-size: clamp(1.125rem, 1rem + .65vw, 1.5rem);
      line-height: 1.55;
    }

  }

  @media (max-width: 32rem) {
    .hero-content {
      padding-bottom: 1.5rem;
    }

    .hero-actions {
      width: 100%;
    }

    .hero-button {
      flex: 1 1 calc(50% - .375rem);
      min-height: 3.1rem;
      padding-inline: .8rem;
      font-size: .92rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .hero-button-secondary {
      background-color: rgb(23 21 19 / 76%);
    }
  }
</style>
