---
import type { PublicLink, SiteContent } from "../types/site";
import type { SiteUiCopy } from "../data/ui";
import { socialIcons } from "../data/social-icons";

type Props = {
  hero: SiteContent["hero"];
  links: PublicLink[];
  ui: SiteUiCopy["hero"];
};

const { hero, links, ui } = Astro.props;
const words = hero.title.split(" ");

const icons = socialIcons;

const profiles = links.filter((link) => icons[link.label]);
---

<section class="hero k-stage" aria-labelledby="hero-title" data-tone="light">
  <div class="hero-container">
    <p class="hero-name" data-cube="name">
      <span class="hero-avatar">
        <img src="/images/leonardo-mini.webp" alt="" width="24" height="16" loading="eager" decoding="async" />
      </span>
      <span>{hero.name}</span>
    </p>

    <h1 id="hero-title" class="hero-headline k-headline">
      {words.map((word, index) => (
        <span data-cube style={`--i: ${index}`}>{word}</span>
        <span> </span>
      ))}
    </h1>

    <p class="hero-eyebrow" data-cube style={`--i: ${words.length}`}>{hero.eyebrow}</p>

    <a class="hero-cta k-pill" href="#sobre" data-cube style={`--i: ${words.length + 1}`}>
      <span class="hero-cta-dot" aria-hidden="true"></span>
      {ui.primaryCta}
    </a>

    <nav class="hero-profiles" aria-label={ui.actionsLabel}>
      {profiles.map((link, index) => (
        <a
          class="k-circle"
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          data-cube
          style={`--i: ${words.length + 2 + index}`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[link.label]}></path></svg>
        </a>
      ))}
    </nav>
  </div>

  <a class="hero-chevron" href="#sobre" aria-label={ui.secondaryCta} data-cube style={`--i: ${words.length + 6}`}>
    <svg width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M28.1093 31.2433C28.0429 31.2867 27.9571 31.2867 27.8907 31.2433L16.2834 23.6669C16.1429 23.5752 15.9545 23.6166 15.8653 23.7587L15.6566 24.0913C15.5697 24.2299 15.6098 24.4125 15.7468 24.502L27.4534 32.1432C27.7856 32.36 28.2144 32.36 28.5466 32.1432L40.2532 24.502C40.3902 24.4125 40.4303 24.2299 40.3434 24.0913L40.1347 23.7587C40.0455 23.6166 39.8571 23.5752 39.7166 23.6669L28.1093 31.2433Z"
        fill="#0009"
      />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: clamp(4.5rem, 10vh, 6rem) var(--space-page) clamp(4rem, 9vh, 5.5rem);
    background: var(--color-paper);
    color: var(--color-ink);
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 3.5vh, 32px);
    perspective: 512px;
  }

  .hero-name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 -16px;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: -0.64px;
    text-transform: uppercase;
  }

  .hero-avatar {
    display: inline-flex;
    width: 24px;
    height: 16px;
    overflow: hidden;
    border-radius: 96px;
    box-shadow: 0 0 0 3px var(--color-paper);
    background: var(--color-cotton);
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-headline {
    max-width: 14ch;
    margin: 0;
    /* 12vh segura o título em telas curtas (1024x768) sem cortar os ícones */
    font-size: clamp(2.625rem, min(1.5rem + 5vw, 12vh), 6rem);
    line-height: 1.2;
    text-wrap: balance;
    transform-origin: 50% 100%;
  }

  .hero-headline span[data-cube] {
    display: inline-block;
  }

  .hero-eyebrow {
    max-width: 34rem;
    margin: -8px 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, .95rem + .3vw, 1.25rem);
    font-variation-settings: "opsz" 32, "wght" 400;
    letter-spacing: -0.25px;
    line-height: 1.5;
  }

  .hero-cta-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-sky);
  }

  .hero-profiles {
    display: flex;
    justify-content: center;
    gap: 24px;
    height: 48px;
  }

  .hero-chevron {
    position: absolute;
    bottom: clamp(16px, 4vh, 48px);
    left: 50%;
    display: block;
    translate: -50% 0;
    opacity: .7;
    animation: chevron-float 2.4s var(--animat) infinite;
  }

  @keyframes chevron-float {
    50% {
      translate: -50% 6px;
    }
  }

  @media (min-width: 48rem) {
    .hero-container {
      gap: clamp(24px, 5vh, 48px);
    }

    .hero-name {
      margin-bottom: -24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-chevron {
      animation: none;
    }
  }
</style>
