---
import type { SiteContent } from "../types/site";
import type { SiteUiCopy } from "../data/ui";

type Props = {
  hero: SiteContent["hero"];
  ui: SiteUiCopy["hero"];
};

const { hero, ui } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-media">
    <source media="(min-width: 64rem)" srcset="/images/hero-horizon-wide.webp" type="image/webp" />
    <img
      src="/images/hero-horizon-mobile.webp"
      alt={ui.imageAlt}
      width="941"
      height="1672"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </picture>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content page-width">
    <p class="hero-byline">{hero.name} <span>{ui.locationLabel}</span></p>
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title" class="display">{hero.title}</h1>
    <p class="body-large">{hero.description}</p>
    <div class="hero-actions" aria-label={ui.actionsLabel}>
      <a class="hero-button hero-button-primary pressable" href="#sobre">{ui.primaryCta}</a>
      <a class="hero-button hero-button-secondary pressable" href="#repertorio">{ui.secondaryCta}</a>
    </div>
    <a class="hero-next" href="#cultura">{ui.cultureLabel}<span aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 0;
    background: var(--color-ink);
    color: white;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-media,
  .hero-media img,
  .hero-shade {
    position: absolute;
    inset: 0;
  }

  .hero-media {
    z-index: -2;
    display: block;
    height: auto;
    overflow: hidden;
    background: var(--color-sky-light);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .hero-shade {
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(8 12 16 / 4%) 20%, rgb(8 12 16 / 22%) 50%, rgb(8 12 16 / 92%) 100%),
      linear-gradient(90deg, rgb(8 12 16 / 56%), rgb(8 12 16 / 5%) 76%);
  }

  .hero-content {
    display: grid;
    align-content: end;
    min-height: 100svh;
    gap: clamp(1rem, 2vw, 1.6rem);
    padding-top: 8rem;
    padding-bottom: 2rem;
  }

  .hero .eyebrow {
    margin: 0;
    color: white;
  }

  .hero .display {
    max-width: 18ch;
    color: white;
    font-size: clamp(2.65rem, 2rem + 3vw, 4.5rem);
    font-weight: 590;
    line-height: 1.02;
    text-wrap: balance;
  }

  .hero .body-large {
    max-width: 36rem;
    color: rgb(255 255 255 / 88%);
    font-size: clamp(1rem, .94rem + .25vw, 1.125rem);
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    padding-top: .5rem;
  }

  .hero-byline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: absolute;
    inset: 7.5rem 0 auto;
    width: min(100% - var(--space-page) * 2, var(--content-wide));
    margin: 0 auto;
    font-size: .88rem;
    font-weight: 560;
  }

  .hero-byline span { color: rgb(255 255 255 / 78%); }
  .hero-next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3rem;
    margin-top: clamp(2rem, 6vh, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 26%);
    font-size: .85rem;
    text-decoration: none;
  }
  .hero-next span { font-size: 1.3rem; transition: transform 200ms var(--ease-out); }
  .hero-next:hover span { transform: translateY(3px); }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-control);
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: 0;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .hero-button-primary {
    border: 1px solid white;
    background: white;
    color: var(--color-ink);
  }

  .hero-button-secondary {
    border: 1px solid rgb(255 255 255 / 36%);
    background-color: rgb(15 22 26 / 74%);
    color: white;
  }

  .hero-button-primary:hover {
    background: rgb(242 238 231 / 94%);
    border-color: rgb(242 238 231 / 94%);
  }

  .hero-button-secondary:hover {
    border-color: rgb(255 255 255 / 76%);
    background-color: #171513;
    background-color: rgb(23 21 19 / 68%);
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .hero .display {
      font-size: clamp(2.75rem, 5.6vw, 3.6rem);
      line-height: .96;
    }

    .hero .body-large {
      font-size: 1.125rem;
      line-height: 1.5;
    }
  }

  @media (min-width: 64rem) {
    .hero-media img {
      object-position: center;
    }

    .hero-shade {
      z-index: -1;
      background:
        linear-gradient(
          90deg,
          rgb(8 12 16 / 88%) 0%,
          rgb(8 12 16 / 78%) 38%,
          rgb(8 12 16 / 54%) 64%,
          rgb(8 12 16 / 12%) 100%
        );
    }

    .hero .display {
      max-width: 18ch;
      font-size: clamp(4rem, 5.5vw, 5.8rem);
      line-height: 1.01;
    }

    .hero-content {
      align-content: end;
      min-height: min(58rem, 100svh);
      padding-top: 12rem;
      padding-bottom: 1.75rem;
    }

    .hero .body-large {
      font-size: clamp(1.125rem, 1rem + .45vw, 1.3rem);
      line-height: 1.55;
    }

  }

  @media (max-width: 32rem) {
    .hero-content {
      padding-top: 12rem;
      padding-bottom: 1.25rem;
      min-height: 92svh;
    }

    .hero-byline { top: 6rem; font-size: .75rem; }
    .hero .display { max-width: 16ch; font-size: clamp(2.5rem, 10.7vw, 3.35rem); }
    .hero-next { margin-top: 1rem; font-size: .76rem; }

    .hero-actions {
      width: 100%;
    }

    .hero-button {
      flex: 1 1 calc(50% - .375rem);
      min-height: 3.1rem;
      padding-inline: .8rem;
      font-size: .92rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .hero-button-secondary {
      background-color: rgb(23 21 19 / 76%);
    }
  }
</style>
