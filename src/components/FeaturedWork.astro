---
import RepertoireExplorer from "./RepertoireExplorer";
import type { SiteContent } from "../types/site";
import type { SiteUiCopy } from "../data/ui";

type Props = {
  repertoire: SiteContent["repertoire"];
  ui: SiteUiCopy["repertoire"];
};

const { repertoire, ui } = Astro.props;
---

<section id="repertorio" class="work section cotton" aria-labelledby="work-title">
  <div class="page-width work-shell">
    <div class="work-visual">
      <img
        src="/images/systems-workbench.webp"
        alt={ui.imageAlt}
        width="1672"
        height="941"
        loading="lazy"
        decoding="async"
      />
      <div class="work-heading" data-reveal>
        <h2 id="work-title" class="section-title">{repertoire.title}</h2>
        <p class="body-large">{repertoire.description}</p>
      </div>
    </div>
    <RepertoireExplorer areas={repertoire.areas} tabsLabel={ui.tabsLabel} toolsLabel={ui.toolsLabel} client:load />
  </div>
</section>

<style>
  .work {
    --work-cotton-warm: #e8dfd4;
    background: var(--work-cotton-warm);
  }

  .work-shell {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .work-heading {
    position: absolute;
    inset: auto auto clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem);
    z-index: 1;
    display: grid;
    width: min(34rem, calc(100% - 3rem));
    gap: 1.25rem;
  }

  .work-visual {
    position: relative;
    min-height: clamp(34rem, 55vw, 48rem);
    overflow: hidden;
    border-radius: var(--radius-surface);
    background: var(--color-sky);
    isolation: isolate;
  }

  .work-visual::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(90deg, rgb(242 238 231 / 94%) 0%, rgb(242 238 231 / 72%) 38%, transparent 70%);
    content: "";
    pointer-events: none;
  }

  .work-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  .work-heading .section-title {
    max-width: 16ch;
  }

  .work-heading .body-large {
    max-width: 48rem;
    color: rgb(23 21 19 / 72%);
  }

  @media (max-width: 52rem) {
    .work-visual {
      min-height: 34rem;
    }

    .work-visual::after {
      background: linear-gradient(180deg, rgb(232 223 212 / 96%) 0%, rgb(232 223 212 / 78%) 46%, transparent 76%);
    }

    .work-heading {
      inset: 1.5rem 1.5rem auto;
      width: auto;
    }

  }

  @media (max-width: 34rem) {
    .work-visual {
      min-height: 34rem;
      border-radius: 1.25rem;
    }

  }
</style>
