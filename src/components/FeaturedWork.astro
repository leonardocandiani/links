---
import RepertoireExplorer from "./RepertoireExplorer";
import type { SiteContent } from "../types/site";
import type { SiteUiCopy } from "../data/ui";

type Props = {
  repertoire: SiteContent["repertoire"];
  ui: SiteUiCopy["repertoire"];
};

const { repertoire, ui } = Astro.props;
---

<section id="repertorio" class="work section cotton" aria-labelledby="work-title">
  <div class="page-width work-shell">
    <div class="work-visual">
      <div class="work-heading" data-reveal>
        <h2 id="work-title" class="section-title">{repertoire.title}</h2>
        <p class="body-large">{repertoire.description}</p>
      </div>
      <div class="work-image">
        <img
          src="/images/systems-workbench.webp"
          alt={ui.imageAlt}
          width="1672"
          height="941"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <RepertoireExplorer areas={repertoire.areas} tabsLabel={ui.tabsLabel} toolsLabel={ui.toolsLabel} client:load />
  </div>
</section>

<style>
  .work {
    background: var(--color-paper);
  }

  .work-shell {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .work-heading {
    display: grid;
    gap: 1.25rem;
  }

  .work-visual {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .work-image {
    height: 18rem;
    overflow: hidden;
    border-radius: var(--radius-surface);
    background: var(--color-sky);
  }

  .work-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  .work-heading .section-title {
    max-width: 16ch;
  }

  .work-heading .body-large {
    max-width: 48rem;
    color: var(--color-muted);
  }

  @media (max-width: 52rem) {
    .work-visual {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .work-image {
      height: clamp(12rem, 40vw, 18rem);
    }
  }
</style>
