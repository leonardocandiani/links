---
import type { SiteContent } from "../types/site";
import type { SiteUiCopy } from "../data/ui";

type Props = {
  education: SiteContent["education"];
  ui: SiteUiCopy["education"];
};

const { education, ui } = Astro.props;
const isPortuguese = ui.firstMetricContext === "mais rápido";
const trainingMessage = isPortuguese
  ? "Olá, Leonardo. Quero conversar sobre um treinamento de IA para a minha equipe."
  : "Hi Leonardo. I would like to discuss AI training for my team.";
const trainingHref = `https://wa.me/5544998893474?text=${encodeURIComponent(trainingMessage)}`;
---

<section id="educacao" class="education section" aria-labelledby="education-title">
  <div class="page-width education-shell">
    <div class="education-intro" data-reveal>
      <img
        src="/images/education-collaboration.webp"
        alt={ui.imageAlt}
        width="1672"
        height="941"
        loading="lazy"
        decoding="async"
      />
      <div class="education-intro-copy">
        <p class="eyebrow">{education.eyebrow}</p>
        <h2 id="education-title" class="section-title">{education.title}</h2>
        <p class="body-large">{education.description}</p>
      </div>
    </div>

    <p class="education-ambition">{isPortuguese ? "A ambição: ampliar a capacidade de cada pessoa." : "The ambition: expand what each person can do."}</p>
    <div class="education-leverage" aria-label={ui.leverageLabel}>
      {
        education.leverage.map((item, index) => (
          <div class="education-leverage-item">
            <p class="education-metric">
              <span class="education-metric-value">{item.metric}</span>
              {" "}
              {index === 0 && <span class="education-metric-context">{ui.firstMetricContext}</span>}
            </p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))
      }
    </div>

    <p class="education-note">{education.note}</p>

    <ol class="education-method" aria-label={ui.methodLabel}>
      {
        education.method.map((step) => (
          <li>
            <span class="education-method-number" aria-hidden="true">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="education-footer">
      <p>{isPortuguese ? "Vamos desenhar o treinamento a partir dos desafios da sua equipe." : "Let's design the training around your team's challenges."}</p>
      <a class="education-cta pressable" href={trainingHref}>{education.ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .education {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .education-shell {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .education-intro {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-surface);
    background: transparent;
    isolation: isolate;
  }

  .education-intro-copy {
    position: relative;
    z-index: 1;
    display: grid;
    width: 100%;
    gap: 1.4rem;
    padding-block: 1rem;
  }

  .education-intro > img {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 4.6;
    border-radius: var(--radius-surface);
    object-fit: cover;
    object-position: center;
  }

  .education-intro .section-title {
    max-width: 17ch;
  }

  .education-intro .body-large {
    max-width: 55rem;
    color: rgb(23 21 19 / 72%);
  }

  .education-leverage {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid rgb(23 21 19 / 18%);
  }

  .education-leverage-item {
    display: grid;
    align-content: start;
    min-height: 17rem;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.75rem);
  }

  .education-leverage-item + .education-leverage-item {
    border-left: 1px solid rgb(23 21 19 / 18%);
  }

  .education-metric {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .4rem .8rem;
    margin: 0 0 1.75rem;
    color: var(--color-ink);
    letter-spacing: 0;
  }

  .education-metric-value {
    font-size: clamp(4rem, 4rem + 3vw, 7rem);
    font-weight: 680;
    line-height: .82;
  }

  .education-metric-context {
    max-width: 7rem;
    color: var(--color-graphite);
    font-size: clamp(1rem, .9rem + .45vw, 1.35rem);
    font-weight: 730;
    line-height: 1;
  }

  .education-leverage h3,
  .education-method h3 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.35rem, 1.18rem + .8vw, 2rem);
    font-weight: 690;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .education-leverage p:not(.education-metric),
  .education-method p,
  .education-footer p {
    margin: .9rem 0 0;
    color: rgb(23 21 19 / 72%);
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1.55;
  }

  .education-method {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education-method li {
    display: grid;
    align-content: start;
    gap: clamp(1.5rem, 4vw, 3rem);
    min-height: 12rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-top: 1px solid rgb(23 21 19 / 16%);
    border-right: 1px solid rgb(23 21 19 / 12%);
  }

  .education-method li:last-child {
    border-right: 0;
  }

  .education-method-number {
    color: var(--color-graphite);
    font-size: .88rem;
    font-weight: 780;
    letter-spacing: 0;
    line-height: 1;
  }

  .education-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid rgb(23 21 19 / 18%);
  }

  .education-footer p {
    max-width: 50rem;
    margin: 0;
    font-size: .98rem;
  }

  .education-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    padding-inline: 1.15rem;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-control);
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: .96rem;
    font-weight: 730;
    letter-spacing: 0;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .education-cta:hover {
    background: var(--color-graphite);
  }

  .education-ambition { margin: 1rem 0 -1.5rem; color: var(--color-graphite); font-size: .95rem; }
  .education-note { max-width: 72ch; margin: -1.5rem 0 0; font-size: .85rem; line-height: 1.6; color: var(--color-muted); }
  .education-intro .eyebrow { margin: 0; }

  @media (max-width: 58rem) {
    .education-method {
      grid-template-columns: 1fr;
    }

    .education-intro {
      display: grid;
      grid-template-columns: 1fr;
      min-height: 0;
      overflow: visible;
      background: transparent;
    }

    .education-intro > img {
      position: static;
      aspect-ratio: 16 / 11;
      border-radius: var(--radius-surface);
      object-position: 37% center;
    }

    .education-intro-copy {
      position: relative;
      inset: auto;
      width: auto;
      margin: 0;
      padding: 0;
    }

    .education-leverage {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      border: 0;
    }

    .education-leverage::-webkit-scrollbar {
      display: none;
    }

    .education-leverage-item {
      min-height: 0;
      padding: 1.5rem;
      border: 1px solid rgb(23 21 19 / 16%);
      border-radius: 1.25rem;
      background: var(--color-sky-light);
    }

    .education-leverage-item + .education-leverage-item {
      margin-top: 1rem;
      border-left: 1px solid rgb(23 21 19 / 16%);
    }

    .education-method li {
      min-height: auto;
      padding-inline: 0;
      border-right: 0;
    }

    .education-footer {
      display: grid;
      justify-items: start;
    }

    .education-cta {
      white-space: normal;
      text-align: center;
    }

    .education-ambition { margin-bottom: -.75rem; }
  }

</style>
