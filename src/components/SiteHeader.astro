---
import MobileNav from "./MobileNav";
import type { PublicLink } from "../types/site";
import type { SiteUiCopy } from "../data/ui";

type Props = {
  navigation: PublicLink[];
  ui: SiteUiCopy["header"];
};

const { navigation: navItems, ui } = Astro.props;
---

<script is:inline>
  document.documentElement.classList.add("js");
</script>
<header class="site-header">
  <div class="header-shell material">
    <a class="brand pressable" href="#conteudo" aria-label={ui.homeLabel}>
      <span class="brand__given">Leonardo</span>
      <span class="brand__surname">Candiani</span>
    </a>
    <nav class="desktop-nav" aria-label={ui.primaryNavLabel}>
      {navItems.map((item) => (
        <a class="pressable" data-nav-link href={item.href}>{item.label}</a>
      ))}
      <a
        class="language-switch pressable"
        href={ui.languageHref}
        lang={ui.languageHref === "/" ? "pt-BR" : "en"}
        aria-label={ui.languageLabel}
      >{ui.languageCode}</a>
    </nav>
    <div class="mobile-controls">
      <a
        class="language-switch mobile-language-switch pressable"
        href={ui.languageHref}
        lang={ui.languageHref === "/" ? "pt-BR" : "en"}
        aria-label={ui.languageLabel}
      >{ui.languageCode}</a>
      <details class="mobile-nav-fallback">
        <summary class="nav-trigger pressable">{ui.menuLabel}</summary>
        <nav aria-label={ui.noJsNavLabel}>
          {navItems.map((item) => (
            <a class="pressable" data-nav-link href={item.href}>{item.label}</a>
          ))}
          <a class="pressable" href={ui.languageHref} lang={ui.languageHref === "/" ? "pt-BR" : "en"}>{ui.languageLabel}</a>
        </nav>
      </details>
      <MobileNav items={navItems} ui={ui} client:load />
    </div>
  </div>
</header>

<style is:global>
  .site-header {
    position: fixed;
    top: 1rem;
    right: 0;
    left: 0;
    z-index: 50;
    padding-inline: var(--space-page);
    pointer-events: none;
  }

  .header-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    width: min(100%, 70rem);
    min-height: 3.75rem;
    margin-inline: auto;
    padding: .4375rem;
    border: 1px solid var(--color-line);
    border-radius: .875rem;
    background-color: rgb(251 250 247 / 94%);
    box-shadow: 0 2px 8px rgb(23 21 19 / 5%);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    pointer-events: auto;
  }

  .brand,
  .desktop-nav a,
  .nav-trigger,
  .nav-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    border-radius: .4375rem;
    color: var(--color-ink);
    font-size: .9rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.15;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header .brand {
    flex: 0 0 auto;
    align-items: center;
    gap: .3em;
    padding-inline: .75rem;
    background: transparent;
  }

  .site-header .brand__given {
    font-weight: 500;
  }

  .site-header .brand__surname {
    font-weight: 700;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: .125rem;
  }

  .desktop-nav a {
    padding-inline: clamp(.5rem, .75vw, .75rem);
    color: var(--color-graphite);
  }

  .desktop-nav .language-switch {
    margin-left: .25rem;
    border-left: 1px solid var(--color-line);
    border-radius: 0 .4375rem .4375rem 0;
  }

  .site-header .mobile-language-switch {
    display: none;
  }

  .mobile-controls {
    display: none;
  }

  .desktop-nav a:hover,
  .nav-trigger:hover,
  .nav-close:hover {
    background-color: rgb(23 21 19 / 6%);
    color: var(--color-ink);
  }

  [data-nav-link][aria-current="location"] {
    color: var(--color-ink);
    background-color: rgb(23 21 19 / 7%);
  }

  .mobile-nav,
  .mobile-nav-fallback {
    display: none;
  }

  .nav-trigger,
  .nav-close {
    border: 1px solid var(--color-line);
    background-color: transparent;
    cursor: pointer;
    font-family: inherit;
  }

  .nav-trigger {
    padding-inline: 1rem;
  }

  .mobile-nav-fallback {
    position: relative;
  }

  .mobile-nav-fallback summary {
    list-style: none;
    cursor: pointer;
  }

  .mobile-nav-fallback summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav-fallback nav {
    position: absolute;
    top: calc(100% + .75rem);
    right: 0;
    display: grid;
    width: min(78vw, 18rem);
    padding: .5rem;
    border: 1px solid var(--color-line);
    border-radius: .75rem;
    background-color: var(--color-paper);
    box-shadow: var(--shadow-float);
  }

  .mobile-nav-fallback a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: .9rem;
    border-radius: .5rem;
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: 0;
    text-decoration: none;
  }

  .mobile-nav-fallback a:hover {
    background-color: rgb(23 21 19 / 6%);
  }

  .nav-scrim {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 70;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 100dvh;
    max-height: 100dvh;
    padding: 1rem 1rem max(1rem, env(safe-area-inset-bottom));
    background-color: rgb(23 21 19 / 28%);
    opacity: 1;
    transition: opacity var(--duration-ui) var(--ease-out);
  }

  .nav-scrim[data-state="closed"] {
    opacity: 0;
    pointer-events: none;
  }

  .nav-sheet {
    width: min(100%, 28rem);
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: .75rem;
    border: 1px solid var(--color-line);
    border-radius: .75rem;
    background-color: var(--color-paper);
    box-shadow: var(--shadow-float);
    transform: translateY(0);
    transition: transform var(--duration-ui) var(--ease-out);
  }

  .nav-scrim[data-state="closed"] .nav-sheet {
    transform: translateY(100%);
  }

  .nav-close {
    width: 100%;
    margin-bottom: .5rem;
    padding-inline: 1rem;
  }

  .nav-sheet nav {
    display: grid;
    gap: .25rem;
  }

  .nav-sheet a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: 1rem;
    border-radius: .5rem;
    color: var(--color-ink);
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: 0;
    text-decoration: none;
  }

  .nav-sheet a:hover {
    background-color: rgb(23 21 19 / 6%);
  }

  @media (max-width: 1099.98px) {
    .site-header {
      top: .75rem;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-controls {
      display: flex;
      align-items: center;
      margin-left: auto;
    }

    .site-header .mobile-language-switch {
      display: inline-flex;
      min-width: 2.75rem;
      min-height: 2.75rem;
      border-right: 1px solid var(--color-line);
      border-radius: 0;
    }

    .mobile-nav,
    .mobile-nav-fallback {
      flex: 0 0 auto;
    }

    .mobile-nav-fallback {
      display: block;
    }

    .mobile-nav[data-hydrated="true"] {
      display: block;
    }

    .mobile-controls:has(.mobile-nav[data-hydrated="true"]) .mobile-nav-fallback {
      display: none;
    }

    .nav-trigger {
      min-height: 2.75rem;
      padding-inline: .85rem;
      border: 0;
      background: transparent;
      font-size: .9rem;
    }
  }

  @media (max-width: 22rem) {
    .site-header .brand {
      padding-inline: .375rem;
      font-size: .82rem;
    }

    .nav-trigger {
      padding-inline: .6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-scrim {
      transition: none;
    }

    .nav-sheet,
    .nav-scrim[data-state="closed"] .nav-sheet {
      transform: none;
      transition: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .header-shell {
      background-color: var(--color-paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .nav-scrim {
      background-color: var(--color-graphite);
    }
  }
</style>
