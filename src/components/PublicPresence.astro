---
import type { PublicLink } from "../types/site";
import type { SiteUiCopy } from "../data/ui";
import { socialIcons } from "../data/social-icons";

type Props = {
  links: PublicLink[];
  ui: SiteUiCopy["presence"];
};

const { links, ui } = Astro.props;
const channels = links.filter((link) => ui.channels[link.label as keyof typeof ui.channels]);
---

<section class="public-presence section" aria-labelledby="presence-title" data-rail={ui.linksLabel}>
  <div class="page-width presence-shell">
    <div class="presence-content" data-reveal>
      <p class="eyebrow">{ui.kicker}</p>
      <h2 id="presence-title" class="section-title">{ui.title}</h2>
      <p class="body-large">{ui.description}</p>
    </div>
    <ul class="presence-links" aria-label={ui.linksLabel} data-reveal>
      {
        channels.map((link) => {
          const channel = ui.channels[link.label as keyof typeof ui.channels];
          return (
            <li>
              <a class="presence-card pressable" href={link.href} target="_blank" rel="noopener noreferrer">
                <span class="presence-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d={socialIcons[link.label]}></path></svg>
                </span>
                <span class="presence-text">
                  <span class="presence-name">{link.label} <span class="presence-handle">{channel.handle}</span></span>
                  <span class="presence-note">{channel.note}</span>
                </span>
                <span class="presence-open" aria-hidden="true">{ui.openLabel} ↗</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .public-presence {
    display: grid;
    align-content: center;
    background: var(--color-paper);
  }

  .presence-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .presence-content {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .presence-content .section-title {
    max-width: 12ch;
  }

  .presence-content .body-large {
    max-width: 30rem;
  }

  .presence-links {
    display: grid;
    gap: .75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .presence-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.1rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-surface);
    background: var(--color-cotton);
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color var(--duration-ui) var(--ease-out), translate var(--duration-ui) var(--ease-out);
  }

  .presence-card:hover {
    background: #e9e9e9;
    translate: 0 -2px;
  }

  .presence-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  .presence-icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: currentColor;
  }

  .presence-text {
    display: grid;
    gap: .2rem;
    min-width: 0;
  }

  .presence-name {
    font-size: 1.05rem;
    font-variation-settings: "opsz" 20, "wght" 600;
    letter-spacing: -0.01em;
  }

  .presence-handle {
    margin-left: .35rem;
    color: var(--color-muted);
    font-variation-settings: "opsz" 20, "wght" 450;
  }

  .presence-note {
    color: var(--color-muted);
    font-size: .95rem;
    line-height: 1.45;
  }

  .presence-open {
    color: var(--color-muted);
    font-size: .85rem;
    font-variation-settings: "opsz" 14, "wght" 600;
    white-space: nowrap;
  }

  @media (max-width: 64rem) {
    .presence-shell {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .presence-open {
      display: none;
    }
  }
</style>
